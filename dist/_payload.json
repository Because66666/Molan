[{"data":1,"prerenderedAt":309},["ShallowReactive",2],{"news-home":3,"latest-issue":267},[4,157,186,216,240],{"id":5,"title":6,"author":7,"body":8,"date":148,"description":14,"excerpt":149,"extension":150,"meta":151,"navigation":152,"path":153,"seo":154,"stem":155,"__hash__":156},"news/news/Contribution.md","【置顶】给《方圆》投稿吧！","抹岚报社",{"type":9,"value":10,"toc":144},"minimark",[11,15,18,24,27,33,36,45,47,53,60,78,83,100,102,107,127,129,132,135,138,141],[12,13,14],"p",{},"《方圆》是由抹岚报社主办、抹岚文宣部发行的综合性月刊杂志。已出版的《方圆》可以在审判之锤服务器的主群、布告板群，RIA的红群、白群、黑群、留言牌群和抹岚报社档案馆下载阅读。",[12,16,17],{},"我们接受原创稿件的投稿和转载稿件的推荐。投稿内容无边界，从一座小桥的落成，到一片聚落的历史；从读书时的所思所想，到颠勺时的灵光一闪——将这些片刻间的想法凝聚成文字，就可以投给我们。经过我们的简要审查后就可以发表在下一期的《方圆》上。",[12,19,20],{},[21,22,23],"em",{},"《方圆》杂志的发行范围：RIA社群、审判之锤服务器社群（内部发行）",[12,25,26],{},"——————",[12,28,29],{},[30,31,32],"strong",{},"稿约·要约",[12,34,35],{},"投稿方式：",[12,37,38,39],{},"自助投稿处投稿（含摘阅）：",[40,41,42],"a",{"href":42,"rel":43},"https://wj.qq.com/s2/9303354/e607/",[44],"nofollow",[12,46,26],{},[12,48,49,52],{},[30,50,51],{},"稿费标准","：",[54,55,56],"ul",{},[57,58,59],"li",{},"RIA（〇币、△币）：",[61,62,63,66,69,72,75],"ol",{},[57,64,65],{},"小说、散文类：5.5~4.5/百字",[57,67,68],{},"杂谈、杂记类：5.5~4.5/百字",[57,70,71],{},"诗歌类：15~5/五行",[57,73,74],{},"影视/音乐/书籍推荐、教程类：60~45/篇",[57,76,77],{},"其他类：最高不超过85/篇",[54,79,80],{},[57,81,82],{},"审判之锤（钻石）：",[61,84,85,88,91,94,97],{},[57,86,87],{},"小说、散文类：10~6/百字",[57,89,90],{},"杂谈、杂记类：10~6/百字",[57,92,93],{},"诗歌类：17~6/五行",[57,95,96],{},"影视/音乐/书籍推荐、教程类：120-80/篇",[57,98,99],{},"其他类：最高不超过160/篇",[12,101,26],{},[12,103,104,52],{},[30,105,106],{},"特别注意",[54,108,109,112,115,118],{},[57,110,111],{},"推荐摘阅时，请先明确原文所规定的转载协议，并于投稿时认真填写相关项目。我们会在收到摘阅投稿后再次进行转载协议许可审查。",[57,113,114],{},"若包含图片或图表，请将图片源文件或Excel表格同稿件一同打包。",[57,116,117],{},"若包含文内注释或脚注，请使用Word文档的侧边批注功能注出。",[57,119,120,121,126],{},"我们保护投稿者对单篇稿件的著作权。本刊默认使用",[40,122,125],{"href":123,"rel":124},"https://creativecommons.org/licenses/by-nc-sa/4.0/",[44],"CC BY-NC-SA 4.0","授权转载，若有保留意见，请在投稿时注明。",[12,128,26],{},[12,130,131],{},"稿约自2024年4月刊起生效",